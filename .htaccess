Options -Indexes

# --- Block dotfiles (.env, .git/*, .htaccess, .claude, etc.) ---
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>

# --- Block infra/config/secret-adjacent files served from the document root ---
<FilesMatch "^(docker-compose\.ya?ml|Dockerfile|composer\.(json|lock)|package(-lock)?\.json|README\.md)$">
  Require all denied
</FilesMatch>

# --- Block sensitive file extensions anywhere in the tree ---
<FilesMatch "\.(sql|zip|rar|bak|log)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- Block internal folders from direct web access ---
  RewriteRule ^\.git(/|$) - [F,L]
  RewriteRule ^V01/utilities(/|$) - [F,L]
  RewriteRule ^ui/ - [F,L]
  RewriteRule ^docs/ - [F,L]
  RewriteRule ^_unused_review/ - [F,L]
  RewriteRule ^\.claude/ - [F,L]

  # --- Lock down /process/ to the endpoints actually used by the public site ---
  RewriteRule ^process/actions/(mail|action)\.php$ - [L]
  RewriteRule ^process/ - [F,L]

  # 1. Redirect old public .php URLs to their clean equivalents (301)
  RewriteCond %{THE_REQUEST} \s/+(about|projects|services|contact)\.php[?\s] [NC]
  RewriteRule ^(about|projects|services|contact)\.php$ /$1 [R=301,L]

  RewriteCond %{THE_REQUEST} \s/+projects-detail\.php\?id=([0-9]+)\s [NC]
  RewriteRule ^projects-detail\.php$ /projects/%1? [R=301,L]

  # 2. Serve existing files/directories as-is (assets, /process/actions/mail.php, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Map clean URLs to the internal PHP files
  RewriteRule ^about/?$ about.php [L]
  RewriteRule ^projects/?$ projects.php [L]
  RewriteRule ^services/?$ services.php [L]
  RewriteRule ^contact/?$ contact.php [L]
  RewriteRule ^projects/([0-9]+)/?$ projects-detail.php?id=$1 [L,QSA]
</IfModule>
