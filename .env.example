DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=
MYSQL_ROOT_PASSWORD=
PMA_USER=
PMA_PASSWORD=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
IPGEOLOCATION_API_KEY=

# Google Business Profile Reviews OAuth (see V01/utilities/google-reviews/)
GOOGLE_REVIEWS_CLIENT_ID=
GOOGLE_REVIEWS_CLIENT_SECRET=
GOOGLE_REVIEWS_REDIRECT_URI=https://www.aazdsgn.com/google-reviews-oauth-callback.php
# Set to "false" after the refresh token has been obtained, to disable
# google-reviews-auth.php and google-reviews-oauth-callback.php.
GOOGLE_REVIEWS_SETUP_ENABLED=true

# Optional: pin the account/location for the sync job
# (V01/utilities/process/jobs/google_reviews.php) so it skips the
# accounts.list/locations.list discovery calls on every run.
# IMPORTANT: must be the FULL resource name as returned by Google, not a
# bare ID — e.g. "accounts/108229233762028444700", not "108229233762028444700".
# If GOOGLE_REVIEWS_ACCOUNT_ID is set but GOOGLE_REVIEWS_LOCATION_ID is left
# empty, the job still calls locations.list to discover the location, and
# that call requires GOOGLE_REVIEWS_ACCOUNT_ID to already have this full
# "accounts/..." form. Leave both empty to auto-detect (only works when the
# authorized user has exactly one account and that account has exactly one
# location).
GOOGLE_REVIEWS_ACCOUNT_ID=
GOOGLE_REVIEWS_LOCATION_ID=
